{
  "name": "hmb-vault-scm-git",
  "version": "0.2.0",
  "description": "Version your Obsidian vault with git: commit, push, pull, review changes and browse history.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "version": "node version-bump.mjs && conventional-changelog -p conventionalcommits -i CHANGELOG.md && git add manifest.json versions.json CHANGELOG.md",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "git"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@12.15.0",
  "author": "hmadrigal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmadrigal/hmb-vault-scm-git.git"
  }
}
